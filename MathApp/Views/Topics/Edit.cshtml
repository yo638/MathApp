<!--The Create and Edit Modals-->
<script>
        
    var modalCreateMathProblem = document.getElementById("modalCreateMathProblem");
    var btnOpenModalCreateMathProblem = document.getElementById("btncreatopicthProblem");
    var btnCloseModalCreateMathProblem = document.getElementsByClassName("btnclose-create-mathProblem");

    var modalVisibility = sessionStorage.getItem("ModalCreateNewMathProblemVisibility");
    if (modalVisibility === "block") {
        modalCreateMathProblem.style.display = "block";
    } else {
        modalCreateMathProblem.style.display = "none";
    }

    btnOpenModalCreateMathProblem.onclick = function () {
        modalCreateMathProblem.style.display = "block";
        sessionStorage.setItem("ModalCreateNewMathProblemVisibility", "block");
    }

    for (var j = 0; j < btnCloseModalCreateMathProblem.length; j++) {
        btnCloseModalCreateMathProblem[j].onclick = function() {
            modalCreateMathProblem.style.display = "none";
            sessionStorage.setItem("ModalCreateNewMathProblemVisibility", "none");
        };
    }


    var buttonsOpenModalEditMathProblem = document.getElementsByClassName("edit-mathProblem-button");
    var buttonsForDeletingEditedZadachi = document.getElementsByClassName("btn-delete-edit-mathProblem");
    var modalsEdit = [];

    for (var i = 0; i < buttonsOpenModalEditMathProblem.length; i++) {
        (function(i) {
            var modalId = buttonsOpenModalEditMathProblem[i].getAttribute("data-uniqueid");
            var modalEditMathProblem = document.getElementById(modalId);
            modalsEdit.push(modalEditMathProblem);

            // Check session storage for modal visibility
            var modalVisibility = sessionStorage.getItem("ModalEditMathProblemVisibility[" + i + "]");
            if (modalVisibility === "block") {
                modalEditMathProblem.style.display = "block";
            } else {
                modalEditMathProblem.style.display = "none";
            }

            // Set onclick event for opening modal
            buttonsOpenModalEditMathProblem[i].onclick = function() {
                modalEditMathProblem.style.display = "block";
                sessionStorage.setItem("ModalEditMathProblemVisibility[" + i + "]", "block");
            };

            // Set onclick events for closing modal
            var closeButtons = modalEditMathProblem.getElementsByClassName("closemodal");
            for (var j = 0; j < closeButtons.length; j++) {
                closeButtons[j].onclick = function() {
                    modalEditMathProblem.style.display = "none";
                    sessionStorage.setItem("ModalEditMathProblemVisibility[" + i + "]", "none");
                };
            }
        })(i); // Pass the current value of i to the IIFE
    }

    // Close modal when clicking outside of it
    window.onclick = function(event) {
        for (var i = 0; i < modals.length; i++) {
            if (event.target == modals[i]) {
                modals[i].style.display = "none";
                sessionStorage.setItem("ModalEditMathProblemVisibility[" + i + "]", "none");
            }
        }
        if (event.target == modal) {
            modal.style.display = "none";
            sessionStorage.setItem("ModalCreateNewMathProblemVisibility", "none");
        }
    }
</script>
