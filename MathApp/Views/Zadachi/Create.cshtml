@model MathApp.Models.Zadacha

@{
    ViewData["Title"] = "Create";
    Layout = "~/Views/Shared/_LayoutIn.cshtml";
}
<p class="breadcrumb-item" style="color: #78c2ad; margin-top: 2rem;">
    <a href="/Zadachi/Browse">Моите задачи</a> / Нова задача
</p>
<h1 style="margin-top:2rem">Нова задача</h1>

<div>
    <hr />
    <form method="post">
        <fieldset>
            <table style="width:100%;">
                <tr><td colspan="2"><legend class="mt-4" style="margin-bottom:0;">Условие</legend></td></tr>
                <tr>
                    <td colspan="2">
                        <div class="form-group">
                            <textarea name="uslovie" class="form-control" id="uslovieTextArea" rows="6">@Model.uslovie</textarea>
                        </div>
                    </td>
                </tr>
                <tr><td colspan="2"><legend class="mt-4" style="margin-bottom:0;">Решение</legend></td></tr>
                <tr>
                    <td colspan="2">
                        <div class="form-group">
                            <textarea name="solution" class="form-control" id="solutionTextArea" rows="6">@Model.solution</textarea>
                        </div>
                    </td>
                </tr>
                <tr><td colspan="2"><legend class="mt-4" style="margin-bottom:0;">Отговори</legend></td></tr>
                @if (Model.answers != null)
                {
                    @for (var i = 0; i < Model.answers.Count(); i++)
                    {
                        <tr>
                            <td>
                                <div class="form-group">
                                    <label for="answers[i].answer" class="form-label mt-4">Отговор @(i+1)</label>
                                    <input type="text" name="answers[@i].answer" value="@Model.answers[i].answer" class="form-control" id="answers[i].answer" aria-describedby="emailHelp" placeholder="Въведете отговор">
                                </div>
                            </td>
                            <td>
                                <fieldset class="form-group" style="margin-left:40px;margin-top:40px;">
                                    <div class="form-check">
                                        <label class="form-check-label">
                                            <input type="radio" class="form-check-input" name="answers[@i].validity" id="answers[@i].validitytrue" value="true">
                                            Верен
                                        </label>
                                        <script>if("@Model.answers[i].validity"=="True")document.getElementById("answers[@i].validitytrue").checked = true;</script>
                                    </div>
                                    <div class="form-check">
                                        <label class="form-check-label">
                                            <input type="radio" class="form-check-input" name="answers[@i].validity" id="answers[@i].validityfalse" value="false">
                                            Грешен
                                        </label>
                                        <script>if("@Model.answers[i].validity"!="True")document.getElementById("answers[@i].validityfalse").checked = true;</script>
                                    </div>
                                </fieldset>
                            </td>
                        </tr>
                    }
                }
                <tr>
                    <td colspan="2" style="text-align:right">
                        <input type="submit" class="btn btn-primary" value="Добави отговор" formaction="/Zadachi/AddAnswerCreate" />
                        <input type="submit" class="btn btn-primary" value="Премахни отговор" formaction="/Zadachi/RemoveAnswerCreate" />
                    </td>
                </tr>
                <tr><td colspan="2"><legend class="mt-4" style="margin-bottom:0;">Степени на сложност</legend></td></tr>
                @if (Model.categories != null)
                {
                    @for (var i = 0; i < Model.categories.Count(); i++)
                    {
                        <tr>
                            <td>
                                <div class="form-group">
                                    <label for="categories[@i].grade" class="form-label mt-4">Клас</label>
                                    <select name="categories[@i].grade" value="@Model.categories[i].grade" class="form-select" id="categories[@i].grade">
                                        <option value="1">1 клас</option>
                                        <option value="2">2 клас</option>
                                        <option value="3">3 клас</option>
                                        <option value="4">4 клас</option>
                                        <option value="5">5 клас</option>
                                        <option value="6">6 клас</option>
                                        <option value="7">7 клас</option>
                                        <option value="8">8 клас</option>
                                        <option value="9">9 клас</option>
                                        <option value="10">10 клас</option>
                                        <option value="11">11 клас</option>
                                        <option value="12">12 клас</option>
                                    </select>
                                    <script>document.getElementById("categories[@i].grade").selectedIndex = @(Model.categories[i].grade-1);</script>
                                </div>
                            </td>
                            <td>
                                <div class="form-group">
                                    <label for="categories[@i].difficulty" class="form-label mt-4">Ниво</label>
                                    <select name="categories[@i].difficulty" value="@Model.categories[i].difficulty" class="form-select" id="categories[@i].difficulty">
                                        <option value="A">А (задачи за всички ученици)</option>
                                        <option value="B">В (задачи за отлична подготовка)</option>
                                        <option value="C">С (задачи за състезания)</option>
                                    </select>
                                    <script>
                                        if ("@Model.categories[i].difficulty" == "A") document.getElementById("categories[@i].difficulty").selectedIndex = 0;
                                        else if ("@Model.categories[i].difficulty" == "B") document.getElementById("categories[@i].difficulty").selectedIndex = 1;
                                        else document.getElementById("categories[@i].difficulty").selectedIndex = 2;
                                    </script>
                                </div>
                            </td>
                        </tr>
                    }
                }
                <tr>
                    <td colspan="2" style="text-align:right">
                        <input type="submit" class="btn btn-primary" value="Добави степен" formaction="/Zadachi/AddCategoryCreate" />
                        <input type="submit" class="btn btn-primary" value="Премахни степен" formaction="/Zadachi/RemoveCategoryCreate" />
                    </td>
                </tr>
                <tr>
                    <td style="text-align:left">
                        <input type="submit" class="btn btn-primary" value="Назад" formaction="/Zadachi/Browse" style="margin-top:1.5rem;" />
                    </td>
                    <td style="text-align:right">
                        <input type="submit" class="btn btn-primary" value="Запази задачата" formaction="/Zadachi/Create" style="margin-top:1.5rem;" />
                    </td>
                </tr>
            </table>
        </fieldset>
    </form>

</div>
@if (ViewBag.Message != null)
{
    <script>
        toastr["@ViewBag.MessageType"]("@ViewBag.Message");
        ViewData.Clear();
    </script>
}