@model IEnumerable<MathApp.Models.Zadacha>

@{
    ViewData["Title"] = "Zadachi";
    Layout = "~/Views/Shared/_LayoutIn.cshtml";
}
<style>
    #mywbtn {
        background-color: #fff;
    }
    #mywbtn:hover {
        background-color: #78c2ad;
    }
    #mygbtn:hover {
        color: #78c2ad;
        background-color: #fff;
        border-color: #78c2ad;
    }
</style>
<ul class="nav nav-tabs" style="margin-top:2rem">
    <li class="nav-item">
        <a class="nav-link active" data-bs-toggle="tab" href="">Задачи</a>
    </li>
    <!--<li class="nav-item">
        <a class="nav-link" data-bs-toggle="tab" href="/RecycleBin/Temi">Теми</a>
    </li>-->
</ul>

<div class="list-group" style="margin-top:2rem">

    @if (Model != null)
    {
        @for (var i = 0; i < Model.Count(); i = i + 2)
        {
            <div class="list-group-item list-group-item-action flex-column align-items-start active">
                <div class="d-flex w-100 justify-content-between">
                    <h5 class="mb-1">Задача @(i+1)</h5>
                    <small>@Model.ElementAt(i).timeago</small>
                </div>
                <p class="mb-1">@Model.ElementAt(i).uslovie</p>
                <a asp-action="RecoverZadacha" asp-route-id="@Model.ElementAt(i).idZadacha" id="mywbtn" class="btn btn-outline-primary btn-sm">Възстанови задачата</a>
                <a asp-action="DeleteZadacha" asp-route-id="@Model.ElementAt(i).idZadacha" id="mywbtn" class="btn btn-outline-primary btn-sm">Изтрии задачата</a>
            </div>

            @if (i < Model.Count() - 1)
            {
            <div class="list-group-item list-group-item-action flex-column align-items-start">
                <div class="d-flex w-100 justify-content-between">
                    <h5 class="mb-1">Задача @(i + 2)</h5>
                    <small>@Model.ElementAt(i + 1).timeago</small>
                </div>
                <p class="mb-1">@Model.ElementAt(@i + 1).uslovie</p>
                <a asp-action="RecoverZadacha" asp-route-id="@Model.ElementAt(i+1).idZadacha" id="mygbtn" class="btn btn-primary btn-sm">Възстанови задачата</a>
                <a asp-action="DeleteZadacha" asp-route-id="@Model.ElementAt(i+1).idZadacha" id="mygbtn" class="btn btn-primary btn-sm">Изтрии задачата</a>
                <!--<button type="button" name="deletezadacha" class="btn btn-primary btn-sm">Изтрии задачата</button>-->
            </div>
            }
        }
    }

    <div class="modal" id="mymodal">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Изтриване на задачата</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true"></span>
                    </button>
                </div>
                <div class="modal-body">
                    <p>Сигурни ли сте, че искате перманентно да изтриете задачата? Това действие не може да бъде възстановено.</p>
                </div>
                <div class="modal-footer">
                    <button type="submit" asp-action="AddToRecycleBin" asp-route-id="" class="btn btn-danger">Да, искам</button>
                    <button type="button" id="closemodal" class="btn btn-primary" data-bs-dismiss="modal">Не, не искам</button>
                </div>
            </div>
        </div>
    </div>

</div>
@if (ViewBag.Message != null)
{
    <script>
        toastr["@ViewBag.MessageType"]("@ViewBag.Message");
        ViewData.Clear();
    </script>
}
<script>
    var modal = document.getElementById("mymodal");
    var btn = document.getElementsByName("deletezadacha")[0];
    var span1 = document.getElementsByClassName("btn-close")[0];
    var span2 = document.getElementsByClassName("btn btn-primary")[0];

    btn.onclick = function () {
        modal.style.display = "block";
        
    }

    span1.onclick = function () {
        modal.style.display = "none";
    }
    span2.onclick = function () {
        modal.style.display = "none";
    }

    window.onclick = function (event) {
        if (event.target == modal) {
            modal.style.display = "none";
        }
    }
</script>