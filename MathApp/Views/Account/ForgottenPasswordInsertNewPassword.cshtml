@model MathApp.Models.DbModels.User

@{
    ViewData["Title"] = "Login";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<h1 style="margin-top:2rem">Смяна на паролата</h1>
<script src="~/Scripts/site.js"></script>
<div>
    <hr />
    <form name="RegisterForm" method="post" action="Register" onsubmit="return true" id="ChangePasswordForm">
    <input type="hidden" name="Id" value="@Model.Id" />
    <input type="hidden" name="Email" value="@Model.Email" />
    <table width="65%" align="center">
        <tr>
            <td colspan="2">
                <label class="form-label mt-4">Кода за смяна на парола:</label>
                <input type="text" class="form-control" name="ChangePasswordCode"  placeholder = "Въведете кода за смяна на парола">
            </td>
        </tr>
        <tr>
            <td colspan="2">
                <label class="form-label mt-4">Нова парола:</label>
                <input type="password" name="Password" class="form-control" id="Password" placeholder = "Въведете новата парола">
                <div id="passwordError" style="color:red"></div>
            </td>
        </tr>
        <tr>
            <td colspan="2">
                <label class="form-label mt-4">Повторете новата парола:</label>
                <input type="password" class="form-control" id="RepeatPassword"  placeholder = "Повторете новата парола">
                <div id="repeatPasswordError" style="color:red"></div>
            </td>
        </tr>

        <tr>
            <td style="text-align:left">
                <input type="submit" id="submitbtn1" class="btn btn-primary send-code" formaction="/Account/ForgottenPasswordSendEmail" value="Изпрати нов код" style="margin-top:2rem" />
            </td>
            <td style="text-align:right">
                <input type="submit" id="submitbtn2" class="btn btn-primary" value="Запазване на паролата" formaction="/Account/ChangeForgottenUserPassword" style="margin-top:1.5rem;"/>
            </td>
        </tr>
    </table>
    </form>
</div>
<script>
document.getElementById('submitbtn1').addEventListener('click',
    function(event) {
        var form = document.getElementById("ChangePasswordForm");
        form.onsubmit = function() {
            return true;
        };
    });
document.getElementById('submitbtn2').addEventListener('click',
    function(event) {
        var form = document.getElementById("ChangePasswordForm");
        form.onsubmit = function() {
            return validateUserChangePassword();
        };
    });
</script>
    @if (ViewBag.Message != null)
    {
        <script>
        toastr["@ViewBag.MessageType"]("@ViewBag.Message");
        ViewData.Clear();
        </script>
    }

