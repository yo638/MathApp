@model MathApp.Models.DbModels.User

@{
    ViewData["Title"] = "Login";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<h1 style="margin-top:2rem">Смяна на паролата</h1>

<div>
    <hr />
    @using (Html.BeginForm("Login", "Account", FormMethod.Post))
    {
    <table width="65%" align="center">
        <tr>
            <td>
                <label class="form-label mt-4">Имейл</label>
                <input type="text" name="Email" class="form-control" id="Username" placeholder = "Въведете имейл" value = "email2@gmail.com">
            </td>
        </tr>
        <tr>
            <td style="text-align:right">
                <input type="submit" id="submitbtn" class="btn btn-primary" formaction="/Account/ForgottenPasswordSendEmail" value="Изпрати код за смяна на парола" style="margin-top:2rem" />
            </td>
        </tr>
    </table>
    }
</div>

    @if (ViewBag.Message != null)
    {
        <script>
        toastr["@ViewBag.MessageType"]("@ViewBag.Message");
        ViewData.Clear();
        </script>
    }

