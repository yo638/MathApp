@model MathApp.Models.User

@{
    ViewData["Title"] = "Register";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h1 style="margin-top:2rem">Регистрация</h1>

<div class="form-group row">
    <hr />
    @using (Html.BeginForm("Register", "Account", FormMethod.Post))
    {
    <table width="90%" align="center">
        <tr>
            <td>
                <label class="form-label mt-4">Потребителско име:</label>

                @Html.TextBoxFor(model => model.username, new { @class = "form-control", Placeholder = "Въведете потребителско име" })
            </td>
        </tr>
        <tr>
            <td>
                <label class="form-label mt-4">Имейл:</label>

                @Html.TextBoxFor(model => model.email, new { @class = "form-control", Placeholder = "Въведете имейл" })

                <label class="form-label mt-4">Парола:</label>
            </td>
        </tr>
        <tr>
            <td>
                @Html.TextBoxFor(model => model.password, new { @class = "form-control", @type = "password", Placeholder = "Въведете парола" })

                <label class="form-label mt-4">Повторете паролата:</label>
            </td>
        </tr>
        <tr>
            <td>
                @Html.TextBoxFor(model => model.repeatpassword, new { @class = "form-control", @type = "password", Placeholder = "Повторете паролата" })

                <input type="submit" id="submitbtn" class="btn btn-primary" value="Регистрация" style="margin-top:2rem" />
            </td>
        </tr>
    </table>
    }
</div>

@if (ViewBag.Message != null)
{
    <script>
        toastr["@ViewBag.MessageType"]("@ViewBag.Message");
        ViewData.Clear();
    </script>
}