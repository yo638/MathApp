@model MathApp.Models.DbModels.User

@{
    ViewData["Title"] = "Login";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<h1 style="margin-top:2rem">Вход</h1>

<div>
    <hr />
    <form method="post">
    <table width="65%" align="center">
        <tr>
            <td colspan="2">
                
                <label class="form-label mt-4">Имейл</label>
                <input type="text" name="Email" class="form-control" id="Username" placeholder = "Въведете имейл" value = "email2@gmail.com">
            </td>
        </tr>
        <tr>
            <td colspan="2">
                <label class="form-label mt-4">Парола</label>
                <input type="password" name="Password" class="form-control" id="Password" placeholder = "Въведете парола" value = "111111aA">
            </td>
        </tr>
        <tr>
            <td  style="text-align:left">
                <input type="submit" class="btn btn-primary" value="Забравена парола" formaction="/Account/ForgottenPasswordEnterEmail" style="margin-top:2rem;" />
            </td>
            <td  style="text-align:right">
                <input type="submit" formaction="/Account/Login" id="submitbtn" class="btn btn-primary" value="Вход" style="margin-top:2rem" />
            </td>
        </tr>
    </table>
    </form>
</div>

    @if (ViewBag.Message != null)
    {
        <script>
        toastr["@ViewBag.MessageType"]("@ViewBag.Message");
        ViewData.Clear();
        </script>
    }

