@model MathApp.Models.User

@{
    ViewData["Title"] = "Login";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<h1>Вход</h1>

<div>
    <hr />
    @using (Html.BeginForm("Login", "Account", FormMethod.Post))
    {
        <dl class="row">
            <dt class="col-sm-2">
                Имейл
            </dt>
            <dd class="col-sm-10">
                @Html.TextBoxFor(model => model.email, new { @class = "form-control", Value = "email2@gmail.com" })
            </dd>
            <dt class="col-sm-2">
                Парола
            </dt>
            <dd class="col-sm-10">
                @Html.TextBoxFor(model => model.password, new { @class = "form-control", @type = "password", Value = "111111aA" })
            </dd>
            <dt>
                <input id="submitbtn" type="submit" value="Вход" />
            </dt>
        </dl>
    }
</div>

@if (ViewBag.Message != null)
{
    <script>
        toastr["@ViewBag.MessageType"]("@ViewBag.Message");
        ViewData.Clear();
    </script>
}

<div>
    @Html.ActionLink("Register", "Register") |
    <a asp-action="Register">Back to List</a>
</div>
