@model MathApp.Models.User

@{
    ViewData["Title"] = "Login";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<h1 style="margin-top:2rem">Вход</h1>

<div>
    <hr />
    @using (Html.BeginForm("Login", "Account", FormMethod.Post))
    {
    <table width="90%" align="center">
        <tr>
            <td>
                <label class="form-label mt-4">Имейл</label>
                @Html.TextBoxFor(model => model.email, new { @class = "form-control", Value = "email2@gmail.com", Placeholder = "Въведете имейл" })
            </td>
        </tr>
        <tr>
            <td>
                <label class="form-label mt-4">Парола</label>

                @Html.TextBoxFor(model => model.password, new { @class = "form-control", @type = "password", Value = "111111aA", Placeholder = "Въведете парола" })
            </td>
        </tr>
        <tr>
            <td  style="text-align:right">
                <input type="submit" id="submitbtn" class="btn btn-primary" value="Вход" style="margin-top:2rem" />
            </td>
        </tr>
    </table>
    }
</div>

    @if (ViewBag.Message != null)
    {
        <script>
        toastr["@ViewBag.MessageType"]("@ViewBag.Message");
        ViewData.Clear();
        </script>
    }

